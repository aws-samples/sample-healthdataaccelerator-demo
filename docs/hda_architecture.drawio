        <!-- ============ CONNECTIONS ============ -->
        <!-- Users → Route53 -->
        <mxCell id="c1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#232F3E;" edge="1" parent="1" source="users" target="route53">
