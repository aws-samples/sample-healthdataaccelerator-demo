        <mxCell id="c19" value="ImagingStudy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#8C4FFF;strokeWidth=2;fontSize=8;exitX=1;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="lambda-orthancsync" target="healthlake">
          <mxGeometry relative="1" as="geometry">
