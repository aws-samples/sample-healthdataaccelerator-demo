        <!-- ALB → ECS (straight vertical) -->
        <mxCell id="c6" style="rounded=0;strokeColor=#ED7100;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="alb-openemr" target="ecs-openemr">
