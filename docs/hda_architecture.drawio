        <mxCell id="c17" value="FHIR Resources" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#8C4FFF;strokeWidth=2;fontSize=8;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="lambda-dbsync" target="healthlake">
