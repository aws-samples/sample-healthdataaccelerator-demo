        <mxCell id="c7" style="rounded=0;strokeColor=#ED7100;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="alb-orthanc" target="ecs-orthanc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- CloudFront → API GW (straight vertical) -->
        <mxCell id="c8" style="rounded=0;strokeColor=#E7157B;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="cloudfront" target="apigw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- ECS OpenEMR → Aurora (straight vertical - primary DB connection) -->
        <mxCell id="c9" style="rounded=0;strokeColor=#C925D1;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ecs-openemr" target="aurora">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- ECS OpenEMR → Valkey (horizontal) -->
        <mxCell id="c10" style="rounded=0;strokeColor=#C925D1;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ecs-openemr" target="valkey">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- ECS Orthanc → EFS (straight vertical) -->
        <mxCell id="c11" style="rounded=0;strokeColor=#7AA116;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ecs-orthanc" target="efs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- API GW → Lambda API (straight vertical) -->
        <mxCell id="c12" style="rounded=0;strokeColor=#E7157B;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="apigw" target="lambda-api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- S3 → Lambda Loader (straight horizontal) -->
        <mxCell id="c13" style="rounded=0;strokeColor=#7AA116;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s3-synthea" target="lambda-loader">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Lambda Loader → Aurora (horizontal left) -->
        <mxCell id="c14" style="rounded=0;strokeColor=#ED7100;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="lambda-loader" target="aurora">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Lambda Loader → Orthanc (goes up) -->
        <mxCell id="c15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#ED7100;dashed=1;exitX=0.5;exitY=0;entryX=1;entryY=1;" edge="1" parent="1" source="lambda-loader" target="ecs-orthanc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- === Database connections (clean, no overlaps) === -->
        <!-- DB Sync reads Aurora (horizontal connection) -->
        <mxCell id="c16" style="rounded=0;strokeColor=#C925D1;dashed=1;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="lambda-dbsync" target="aurora">
