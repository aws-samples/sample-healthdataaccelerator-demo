        <!-- Orthanc Sync reads Orthanc (goes up) -->
        <mxCell id="c18" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#ED7100;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="lambda-orthancsync" target="ecs-orthanc">
